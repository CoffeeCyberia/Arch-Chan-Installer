Screen {
    layout: vertical;
}
.title {
    width: 100%;
    background: #fdf6e3;
    text-align: center;
}
#button1area {
    width: 100%;
    height: 1fr;
    align: center middle;
    background: #fdf6e3;
}
#button2area {
    background: #fdf6e3;
    color: #5c6a72;
    align-horizontal: center;
    
}
.button1 {
    width: 16;
    height: 3;
    background: #efebd4;
    color: #5c6a72;
    margin-bottom: 1;
    border: none;
    
    }
.button1:hover{
    background: #93B259;
    color: #efebd4;
}
.button1:focus{
    background: #93B259;
    color: #efebd4;
}
.Installation{
    background: #fdf6e3;
    text-align: center;
    width: 100%;
    align-horizontal: center;
    }

.InstallationTabs{
    background: #fdf6e3;
    border: none;
    border-bottom: none;
}
TabbedContent.Installation Tabs {
    width: 100%;
}
TabbedContent.Installation Tab {
    background: #efebd4;
    color: #5c6a72;
    border: none;
    width: 1fr;
}
TabbedContent.Installation Tab.-active {
    background: #93B259;
    color: #efebd4;
}

TabbedContent.Installation Tab:hover {
    background: #93B259;
    color: #efebd4;
}
TabbedContent.Installation Underline {
    display: none;
}
SeconndScreen {
    height: 100%;
    overflow-y: hidden;
}
.DevSecText{
    width: 100%;
}
.DevSec{
    text-align: center;
    align-horizontal: center
}


RadioSet {
    background: #efebd4;
    color: #5c6a72;
    border: tall #5C6A72;
    width: 60;
}
RadioSet:focus {
    border: tall #93B259;
}
RadioSet:focus > RadioButton.-selected {
    background: #93B259;
    color: #efebd4;
    text-style: bold;
}
RadioButton > .toggle--button {
    color: #5c6a72;
    background: #E6E2CC;
}
RadioButton.-on > .toggle--button {
    color: #93B259;
}
RadioButton:hover {
    background: #93B259 40%;
}
RadioSet:focus > RadioButton.-selected > .toggle--label {
    background: #93B259;
    color: #efebd4;
    text-style: bold;
}
.RadioSetDisk{
    align-horizontal: center;
    margin-top: 3;
}
RadioSet > RadioButton.-selected > .toggle--label {
    background: #93B259 50%;
    color: #5c6a72;
    text-style: none;
}

